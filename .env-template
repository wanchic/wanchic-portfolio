### Application
RAILS_LOG_TO_STDOUT=true

# ====================
#   Docker Server
# ====================

# Docker
DOCKER_VOLUMES_ROOT=./tmp/docker-data

## Docker Compose
COMPOSE_PROFILES=web-build

## Docker Image
DOCKER_IMAGE=wanchic/wanchic-portfolio
DOCKER_IMAGE_VERSION=latest

## Docker Builder Arch
DOCKER_BUILDER=multi

## Docker Caching
DOCKER_CACHE_FROM=type=local,src=.docker-cache
DOCKER_CACHE_TO=type=local,dest=.docker-cache,mode=max,scope=multi

# Docker - Web_App
DOCKER_WEB_APP_PORT=3034

# ====================
#   Database Info
# ====================

# Docker - PostgreSQL
DOCKER_PG_HOST=127.0.0.1
DOCKER_PG_PORT=5440
DOCKER_PG_USER=postgres
DOCKER_PG_PASSWORD=a_good_password
DOCKER_PG_VOLUME=postgresql